# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neobank
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Metabase
METABASE_PORT=3000

# Провижининг Metabase (infra/metabase/setup.py).
# Аккаунт администратора локального Metabase, не настоящая почта.
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=neobank_local_2026

# Роль, которой Metabase подключается к Postgres: только чтение,
# без доступа к berka.client_pii.
# Внимание: пароль задан в infra/sql/007_bi_readonly_role.sql.
# Меняете здесь — меняйте и там, иначе подключение перестанет работать.
BI_DB_USER=bi_readonly
BI_DB_PASSWORD=bi_readonly_local_only

# Хост Postgres с точки зрения контейнера Metabase — имя сервиса
# в compose-сети, а не localhost.
METABASE_DB_HOST=postgres
