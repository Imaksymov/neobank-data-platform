# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neobank
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Metabase
METABASE_PORT=3000

# Провижининг Metabase (infra/metabase/setup.py).
# Аккаунт администратора локального Metabase, не настоящая почта.
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=neobank_local_2026

# Роль, которой Metabase подключается к Postgres: только чтение,
# без доступа к berka.client_pii.
# Внимание: пароль задан в infra/sql/007_bi_readonly_role.sql.
# Меняете здесь — меняйте и там, иначе подключение перестанет работать.
BI_DB_USER=bi_readonly
BI_DB_PASSWORD=bi_readonly_local_only

# Хост Postgres с точки зрения контейнера Metabase — имя сервиса
# в compose-сети, а не localhost.
METABASE_DB_HOST=postgres

# Загрузчик (ingestion/config.py).
# Адрес базы общий с compose (POSTGRES_PORT, POSTGRES_DB выше), а
# учётные данные свои: загрузчик работает ролью ingestion_loader, а не
# суперпользователем из POSTGRES_USER.
# Внимание: роль создаётся DDL недели 3; пароль задан там же.
POSTGRES_HOST=localhost
INGESTION_DB_USER=ingestion_loader
INGESTION_DB_PASSWORD=ingestion_loader_local_only

# Объектное хранилище для загрузчика. Пользователь MinIO создаётся
# на неделе 4; до тех пор запись в озеро невозможна — так и задумано.
MINIO_ENDPOINT=http://localhost:9000
INGESTION_S3_ACCESS_KEY=ingestion_loader
INGESTION_S3_SECRET_KEY=ingestion_loader_local_only
INGESTION_RAW_BUCKET=raw

# Поведение загрузчика.
INGESTION_CHUNK_SIZE=100000
INGESTION_LOOKBACK_DAYS=2
# auto | json | console. auto: JSON вне терминала, текст в терминале.
INGESTION_LOG_FORMAT=auto
