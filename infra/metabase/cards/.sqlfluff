# Локальный конфиг: действует только на запросы карточек дашборда.
#
# В этих файлах алиасы колонок — не идентификаторы для кода, а подписи,
# которые Metabase выводит как заголовки и которые читает человек.
# Кириллица и пробелы в них уместны, а экранированные идентификаторы —
# штатный механизм SQL ровно для таких случаев.
#
# Конфиги sqlfluff сливаются вверх по дереву: остальные настройки
# (диалект, регистр, RF04) наследуются из корневого .sqlfluff.
[sqlfluff:rules:references.special_chars]
quoted_identifiers_policy = none
